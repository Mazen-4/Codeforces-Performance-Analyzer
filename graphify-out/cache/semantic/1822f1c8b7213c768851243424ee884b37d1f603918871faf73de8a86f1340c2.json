url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_attempts_model_pkl", "label": "attempts_model.pkl", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_rating_progression_model_pkl", "label": "rating_progression_model.pkl", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_tag_strength_formula", "label": "tag_strength Formula (6 weighted components)", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Combines acceptance_rate(0.30), difficulty_score(0.30), rating_boost(0.20), specialization_score(0.10), efficiency_score(0.075), volume_score(0.075) to give a 0-1 strength score per (user,tag), used consistently at both training time (strength.py) and inference time (feature_engineering.py) so scales match."}, {"id": "readme_82dim_feature_vector", "label": "82-dim KNN Feature Vector", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "User-level features (rating_boost, efficiency_score) appear once at the end instead of being repeated 20x per tag, to avoid inflating Euclidean distance contributions."}, {"id": "readme_knn_search", "label": "KNN Search (K=50, Euclidean)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_tag_strength_analysis", "label": "Tag Strength Analysis (peer-benchmarked)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TagAnalyzer output (0-100 relative score) is for display only; ML model inputs continue to use absolute tag_strength (0-1) from strength.py to keep training/inference on the same scale."}, {"id": "readme_problem_discovery", "label": "Problem Discovery / Pool Builder", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_solve_score", "label": "solve_score Definition", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "solve_score = (ever_ac - wa_count*0.2).clip(-1,1); many wrong answers before solving is treated similarly to not solving at all, so the model predicts 'how cleanly' not just 'will they solve it'."}, {"id": "readme_sweet_spot_filter", "label": "Sweet Spot Filter (difficulty_match 40-90%)", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only recommend problems with solve_score in [-0.2, 0.8] (difficulty_match 40%-90%) to be challenging but reachable, filtering out too-easy and too-hard problems."}, {"id": "readme_final_ranking_score", "label": "Final Ranking Score (weakness_boost + difficulty_match)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "final_score = 0.6*difficulty_match + 0.4*weakness_boost; problems sorted by weakness_boost first, final_score as tiebreaker, ensuring top results target the user's weakest topics where neighbors are strong."}, {"id": "readme_rating_progression_prediction", "label": "Rating Progression Prediction", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_attempts_estimation", "label": "Attempts Estimation", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Complements the success model: success model predicts whether a user will solve a problem, attempts model predicts how hard it will be. Shares the same 29-dim feature vector as the success model so both models reuse one inference path."}, {"id": "readme_success_model_lightgbm", "label": "Success Model (LightGBM Regressor)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_rating_progression_model", "label": "Rating Progression Model (LightGBM)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_attempts_estimator_model", "label": "Attempts Estimator Model (LightGBM)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "R^2=0.18 is low because 65% of training examples have attempts=1 (solved first try), an extreme right-skew that makes the distribution inherently hard to predict; still useful for relative ranking of problems."}, {"id": "readme_model_comparison_rating_progression", "label": "Model Comparison: Rating Progression (LightGBM vs Linear vs Logistic)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Logistic Regression performs worse because the heavily skewed continuous target (75% of users have potential <=50pts) loses too much signal when binned into ordinal classes."}, {"id": "readme_model_comparison_attempts", "label": "Model Comparison: Attempts Estimator (LightGBM vs Linear vs Logistic)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Logistic Regression achieves negative R^2 (-0.62), worse than predicting the mean; heavily right-skewed target plus binning quantization makes it unsuitable. LightGBM's advantage comes from capturing non-linear interaction between rating_diff and mean_tag_strength."}, {"id": "readme_knn_evaluation", "label": "KNN Leave-One-Out Evaluation", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Weakness Recall of 0.86 means 86% of a user's weak tags also appear weak in their KNN neighbors \u2014 considered the key driver of recommendation quality."}, {"id": "readme_web_application", "label": "Web Application Architecture", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_gemini_coach_endpoint", "label": "POST /api/coach (Gemini 2.5 Flash AI Coaching)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_codeforces_api", "label": "Codeforces API", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_gemini_api", "label": "Gemini 2.5 Flash API", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "readme_main_py", "target": "readme_data_collection_py", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file":