{"nodes": [{"id": "presentation_cf_analyzer", "label": "CF Analyzer Presentation Deck", "file_type": "document", "source_file": "Presentation/CF Analyzer.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "presentation_cf_analyzer_problem_statement", "label": "The Problem: Practicing Without a Plan", "file_type": "concept", "source_file": "Presentation/CF Analyzer.html", "source_location": "Slide 02", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "presentation_cf_analyzer_pipeline_architecture", "label": "Six-Stage Recommendation Pipeline", "file_type": "concept", "source_file": "Presentation/CF Analyzer.html", "source_location": "Slide 03", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "presentation_cf_analyzer_dataset", "label": "Dataset: 2,877 Users / 819K Submissions", "file_type": "concept", "source_file": "Presentation/CF Analyzer.html", "source_location": "Slide 04", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "presentation_cf_analyzer_tag_strength_formula", "label": "Tag Strength Formula", "file_type": "concept", "source_file": "Presentation/CF Analyzer.html", "source_location": "Slide 05", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Weighted combination (30% acceptance rate, 30% difficulty score, 20% rating boost, 10% specialization, 7.5% efficiency, 7.5% volume) designed to measure per-topic skill more precisely than raw solve counts; acceptance rate is Laplace-smoothed and volume uses log-diminishing returns to avoid overweighting high-volume grinding."}, {"id": "presentation_cf_analyzer_knn_peer_matching", "label": "KNN Peer Matching", "file_type": "concept", "source_file": "Presentation/CF Analyzer.html", "source_location": "Slide 06", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses pure NumPy Euclidean distance over 82-dim vectors (4 stats x 20 tags + 2 scalars) against 2,877 precomputed vectors to find 50 nearest neighbors; chosen for sub-second latency without needing an approximate index, since dataset size is small enough for brute force."}, {"id": "presentation_cf_analyzer_three_ml_models", "label": "Three LightGBM Regressor Models", "file_type": "concept", "source_file": "Presentation/CF Analyzer.html", "source_location": "Slide 07", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "presentation_cf_analyzer_model_success", "label": "Model 1: Success (solve_score)", "file_type": "concept", "source_file": "Presentation/CF Analyzer.html", "source_location": "Slide 07", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "solve_score = ever_AC - wa_count*0.2, clipped to [-1,1]; the sweet-spot filter keeping predictions in [-0.2, 0.8] is called out as the single most important design decision making recommendations 'challenging but reachable'."}, {"id": "presentation_cf_analyzer_model_attempts", "label": "Model 2: Attempts Estimator", "file_type": "concept", "source_file": "Presentation/CF Analyzer.html", "source_location": "Slide 07", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "attempts = wa_count + 1, clipped [1,10], trained on solved-only rows (~307K) and bucketed into easy/moderate/hard for UI labels."}, {"id": "presentation_cf_analyzer_model_rating_progression", "label": "Model 3: Rating Progression (untapped)", "file_type": "concept", "source_file": "Presentation/CF Analyzer.html", "source_location": "Slide 07", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "untapped = cf_max_rating - cf_rating, using 38 features (18 contest-behavior signals + 20 tag strengths) to estimate rating ceiling and support weakness-aware ranking."}, {"id": "presentation_cf_analyzer_problem_ranking", "label": "Problem Ranking Algorithm", "file_type": "concept", "source_file": "Presentation/CF Analyzer.html", "source_location": "Slide 08", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "final_score = 0.6*difficulty_match + 0.4*weakness_boost; results sorted by weakness_boost first then final_score so skill gaps lead, ensuring recommendations target the user's actual weak tags rather than generic difficulty matching."}, {"id": "presentation_cf_analyzer_counterfactual_analysis", "label": "Counterfactual Tag Impact Analysis", "file_type": "concept", "source_file": "Presentation/CF Analyzer.html", "source_location": "Slide 09", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Simulates +20% strength per tag, reruns the success model, counts delta_problems entering the sweet spot, and estimates rating gain to convert model output into a single trustworthy, actionable recommendation (e.g. 'practice dp for +62 rating') rather than a flat list of problems."}, {"id": "presentation_cf_analyzer_model_comparison", "label": "Model Comparison vs Linear Baselines", "file_type": "concept", "source_file": "Presentation/CF Analyzer.html", "source_location": "Slide 10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "LightGBM outperforms Linear Regression and Logistic Regression (used as ordinal-proxy) on both rating progression and attempts tasks; logistic regression collapses with negative R\u00b2 on skewed continuous targets, demonstrating unsuitability of classification-style baselines for these regression problems."}, {"id": "presentation_cf_analyzer_web_application", "label": "Web Application Architecture", "file_type": "concept", "source_file": "Presentation/CF Analyzer.html", "source_location": "Slide 11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "React 19 frontend, Express.js backend proxying CF API and spawning Python subprocess, streams to Gemini; CF data and ML pipeline run in parallel via Promise.allSettled so UI degrades gracefully if the ML pipeline fails."}, {"id": "presentation_cf_analyzer_react_frontend", "label": "React 19 Frontend", "file_type": "concept", "source_file": "Presentation/CF Analyzer.html", "source_location": "Slide 11", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "presentation_cf_analyzer_express_backend", "label": "Express.js Backend", "file_type": "concept", "source_file": "Presentation/CF Analyzer.html", "source_location": "Slide 11", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "presentation_cf_analyzer_python_ml_subprocess", "label": "Python ML Subprocess (NumPy + LightGBM)", "file_type": "concept", "source_file": "Presentation/CF Analyzer.html", "source_location": "Slide 11", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "presentation_cf_analyzer_gemini_ai_coach", "label": "Gemini 2.5 Flash AI Coach", "file_type": "concept", "source_file": "Presentation/CF Analyzer.html", "source_location": "Slide 11", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "presentation_cf_analyzer_six_tabs_ui", "label": "Six Dashboard Tabs (Overview, Tag Analysis, Ratings, Recs, Peers, AI Coach)", "file_type": "concept", "source_file": "Presentation/CF Analyzer.html", "source_location": "Slide 11", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "presentation_cf_analyzer_api_endpoints", "label": "API Endpoints (cf proxy, ml analyze, coach)", "file_type": "concept", "source_file": "Presentation/CF Analyzer.html", "source_location": "Slide 11", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "presentation_cf_analyzer_takeaways", "label": "Results and Takeaways", "file_type": "concept", "source_file": 