{"nodes": [{"id": "developer_docs", "label": "CF Analyzer Developer Documentation", "file_type": "document", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "devdocs_datacollector_class", "label": "DataCollector Class", "file_type": "code", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "devdocs_fetch_user_info", "label": "DataCollector.fetch_user_info()", "file_type": "code", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "devdocs_fetch_user_submissions", "label": "DataCollector.fetch_user_submissions()", "file_type": "code", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "devdocs_submission_to_row", "label": "_submission_to_row()", "file_type": "code", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "devdocs_cf_user_info_endpoint", "label": "GET /user.info (Codeforces API)", "file_type": "concept", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "devdocs_cf_user_status_endpoint", "label": "GET /user.status (Codeforces API)", "file_type": "concept", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "devdocs_cf_problemset_problems_endpoint", "label": "GET /problemset.problems (Codeforces API)", "file_type": "concept", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "devdocs_gemini_api", "label": "Google Gemini API (gemini-2.5-flash)", "file_type": "concept", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "devdocs_tag_mapping_table", "label": "Codeforces Tag Mapping Table (raw -> internal tag_* columns)", "file_type": "concept", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "devdocs_dataset_01_submissions_csv", "label": "01_submissions.csv", "file_type": "document", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "devdocs_submissionscleaning_py", "label": "ML/preprocessing/submissionsCleaning.py", "file_type": "code", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Merges is_tle and is_mle into is_wa, drops unverdicted/null-name rows, drops users with <30 accepted submissions (too sparse for KNN), drops problems with no rating and no tags."}, {"id": "devdocs_strength_py", "label": "ML/preprocessing/strength.py", "file_type": "code", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "devdocs_tag_strength_component_acceptance_rate", "label": "Acceptance Rate Component (Laplace smoothed)", "file_type": "rationale", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "acceptance_rate=(ac_count+1)/(total_attempts+2); Laplace smoothing (SMOOTHING=2) prevents division by zero and avoids extreme values for users who tried a tag only once. Weight 0.30 \u2014 primary signal for whether the user can actually solve problems in this tag."}, {"id": "devdocs_tag_strength_component_difficulty_score", "label": "Difficulty Score Component", "file_type": "rationale", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "difficulty_score=avg_rating_solved/MAX_RATING(3500), clipped to [0,1]. Weight 0.30 \u2014 distinguishes someone solving 1000-rated dp from 2500-rated."}, {"id": "devdocs_tag_strength_component_rating_boost", "label": "Rating Boost Component", "file_type": "rationale", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "rating_boost=(cf_rating+cf_max_rating)/(2*MAX_RATING), a user-level constant same across all tags. Weight 0.20 \u2014 users with higher ratings are generally stronger everywhere; averages current and max rating to balance current performance with historical best."}, {"id": "devdocs_tag_strength_component_specialization_score", "label": "Specialization Score Component", "file_type": "rationale", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "specialization_score=ac_count/total_ac. Weight 0.10 \u2014 depth signal rewarding users who focused on a topic rather than spreading thin."}, {"id": "devdocs_tag_strength_component_efficiency_score", "label": "Efficiency Score Component", "file_type": "rationale", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "efficiency_score=first_try_rate, a user-level constant. Weight 0.075 \u2014 clean solves indicate genuine mastery."}, {"id": "devdocs_tag_strength_component_volume_score", "label": "Volume Score Component", "file_type": "rationale", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "volume_score=log(1+ac_count)/log(1+50); uses natural log for diminishing returns (5 vs 0 matters more than 100 vs 110). Weight 0.075 \u2014 breadth of practice matters but has diminishing returns."}, {"id": "devdocs_tag_strength_final_formula", "label": "tag_strength Final Weighted Combination", "file_type": "rationale", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Weights sum to exactly 1.0 across the six components; result clipped to [0,1]."}, {"id": "devdocs_dataset_06_user_tag_strengths_csv", "label": "ML/dataset/06_user_tag_strengths.csv", "file_type": "document", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "devdocs_main_function", "label": "main(handle) Pipeline Orchestrator", "file_type": "code", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "devdocs_compute_target_features", "label": "compute_target_features()", "file_type": "code", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "devdocs_feature_engineer_class", "label": "FeatureEngineer.engineer_features()", "file_type": "code", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "devdocs_82dim_vector_layout", "label": "82-dim Feature Vector Layout (4x20 + 2)", "file_type": "rationale", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "tag_strength itself is not used directly in the KNN vector; the 4 component scores are used so distance metric can respond to specific weaknesses (e.g. low acceptance_rate on dp but high difficulty_score)."}, {"id": "devdocs_knnmodel_class", "label": "KNNModel Class", "file_type": "code", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "devdocs_modelinference_class", "label": "ModelInference Class", "file_type": "code", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "devdocs_euclidean_distance_metric", "label": "Euclidean Distance Metric (KNN)", "file_type": "concept", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "devdocs_similarity_score", "label": "Internal Similarity Score (rank-based)", "file_type": "concept", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Maps the K neighbors' distances to [0%,100%] relative to each other; used for weighted tag analysis and problem scoring."}, {"id": "devdocs_display_similarity_score", "label": "Display Similarity Score (global-max based)", "file_type": "concept", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Maps against the furthest user in the entire dataset so 100% means identical profile; shown in UI peers table."}, {"id": "devdocs_taganalyzer_analyze_function", "label": "TagAnalyzer.analyze()", "file_type": "code", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "devdocs_taganalyzer_acceptance_score", "label": "TagAnalyzer Acceptance Rate Score (weight 0.35)", "file_type": "rationale", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "acc_score = min(user_acceptance_rate/peer_median_acceptance_rate, 1.0); benchmarks user against 50 actual neighbors rather than the whole dataset."}, {"id": "devdocs_taganalyzer_difficulty_score", "label": "TagAnalyzer Difficulty Score (weight 0.35)", "file_type": "rationale", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "devdocs_taganalyzer_specialization_score", "label": "TagAnalyzer Specialization Score (weight 0.10)", "file_type": "rationale", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "devdocs_taganalyzer_volume_score", "label": "TagAnalyzer Volume Score (weight 0.20)", "file_type": "rationale", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "vol_score = 1 - exp(-solved_in_tag/peer_median_solved); exponential ensures diminishing returns, doubling from 5 to 10 matters more than 50 to 100."}, {"id": "devdocs_find_unsolved_problems_function", "label": "find_unsolved_problems()", "file_type": "code", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "devdocs_prioritize_problems_function", "label": "prioritize_problems()", "file_type": "code", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "devdocs_weakness_boost_formula", "label": "weakness_boost Formula", "file_type": "rationale", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "weakness_boost = mean((1-user_strength[tag]) * neighbor_strength[tag]) over problem tags; high value means user is weak in a tag AND successful peers are strong in it \u2014 the highest-value learning opportunities."}, {"id": "devdocs_counterfactual_tag_impact_module", "label": "ML/inference/counterfactual_tag_impact.py", "file_type": "code", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "devdocs_compute_tag_impact_function", "label": "compute_tag_impact()", "file_type": "code", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Simulates boosting each of 20 tags by +0.2 (BOOST constant, representing realistic improvement from a few weeks of focused practice), re-runs the success model on 200 candidate problems, counts delta sweet-spot problems, estimates rating gain via delta_problems/10*50 (empirical constant: ~10 extra solvable problems ~= +50 rating points)."}, {"id": "devdocs_predict_attempts_module", "label": "ML/inference/predict_attempts.py", "file_type": "code", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "devdocs_estimate_attempts_function", "label": "estimate_attempts()", "file_type": "code", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "devdocs_success_model_target", "label": "Success Model Target Variable (solve_score)", "file_type": "concept", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "devdocs_attempts_model_target", "label": "Attempts Model Target Variable (wa_count+1)", "file_type": "concept", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Clipped at 10 to reduce noise from extreme outliers (max in data was 108). Trained on solved problems only since unsolved problems have undefined attempts-to-solve."}, {"id": "devdocs_shared_29dim_feature_vector", "label": "Shared 29-dim Feature Vector (Success + Attempts Models)", "file_type": "concept", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both models use the identical 29-dim vector so training/inference stay consistent; tag_strength values come from strength.py (not TagAnalyzer.py) to match the [0,1] range used at training time."}, {"id": "devdocs_lightgbm_hyperparameters", "label": "LightGBM Model Hyperparameters (shared)", "file_type": "concept", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "devdocs_knn_evaluation_loo", "label": "KNN Leave-One-Out Evaluation", "file_type": "concept", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "devdocs_weakness_jaccard_metric", "label": "Weakness Jaccard Metric", "file_type": "concept", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "devdocs_weakness_recall_metric", "label": "Weakness Recall Metric", "file_type": "concept", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "devdocs_tag_mse_metric", "label": "Tag MSE Metric", "file_type": "concept", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "devdocs_spearman_correlation_metric", "label": "Spearman Correlation Metric", "file_type": "concept", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "devdocs_logistic_regression_ordinal_proxy", "label": "Logistic Regression Ordinal-Proxy Technique", "file_type": "rationale", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Since Logistic Regression is a classifier not a regressor, the continuous target is cut into N_BINS=5 equal-frequency bins via np.percentile, multi-class LR is trained on bin labels, and inference recovers a continuous prediction as predict_proba(x) @ bin_midpoints."}, {"id": "devdocs_app_jsx_component", "label": "App.jsx React Component (single-file, ~700 lines)", "file_type": "code", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "devdocs_server_js_express", "label": "server.js Express Server (3 endpoints)", "file_type": "code", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "devdocs_endpoint_api_cf_handle", "label": "GET /api/cf/:handle (Express endpoint)", "file_type": "concept", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "devdocs_endpoint_api_ml_analyze_handle", "label": "GET /api/ml/analyze/:handle (Express endpoint)", "file_type": "concept", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Spawns .venv/bin/python subprocess running main.py; NumPy types converted to native Python types via a custom convert() function before JSON serialization."}, {"id": "devdocs_endpoint_api_coach", "label": "POST /api/coach (Express endpoint)", "file_type": "concept", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "devdocs_stageprofiler_class", "label": "StageProfiler Class", "file_type": "code", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "devdocs_performance_logs_json", "label": "logs/performance_logs.json", "file_type": "document", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cleared at the start of each run (os.remove() if it exists) so it always contains only the latest run's data."}, {"id": "devdocs_tag_set_reference", "label": "20 Tag Set Reference", "file_type": "concept", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Any Codeforces tag not in the 20-tag list is silently ignored during data collection (e.g. *special, brute force, meet-in-the-middle)."}, {"id": "devdocs_config_constants", "label": "config.py Configuration Constants", "file_type": "concept", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "devdocs_data_flow_diagram", "label": "End-to-End Data Flow Diagram", "file_type": "concept", "source_file": "DEVELOPER_DOCS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "devdocs_datacollector_class", "target": "devdocs_fetch_user_info", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DEVELOPER_DOCS.md", "source_location": null, "weight": 1.0}, {"source": "devdocs_datacollector_class", "target": "devdocs_fetch_user_submissions", "relation": "calls", "confidence": "EXTRACTED", "c